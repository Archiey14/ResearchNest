# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored. Never commit real passwords.

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/researchnest
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Gmail SMTP for 2FA / password-reset emails ---
# Use a Gmail "App Password" (16 characters), not your normal Gmail password.
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS=your-address@gmail.com

# --- Auth ---
# JWT signing secret, at least 32 characters. Required in production.
JWT_SECRET=
# Google OAuth Web Client ID (optional)
GOOGLE_CLIENT_ID=

# Shared secret between this backend and the AI microservice (min 16 characters).
# The AI service's harvester sends it as the X-Service-Key header to POST /api/papers/batch.
# Set the SAME value as an environment variable when you start ai-service.
# Generate one with:  openssl rand -hex 24
# Leave empty to disable (then only a logged-in ADMIN can add papers).
INTERNAL_API_KEY=

# --- Developer mode ---
# true  = demo accounts are seeded, master OTP 123456 works for them, OTPs are printed
#         in the console and fake Google sign-in tokens are accepted. Local development only.
# false = production-safe behaviour (default).
APP_DEV_MODE=false

# Optional: first administrator account to create when APP_DEV_MODE=false (password min 8 chars).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
