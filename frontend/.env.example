# Copy to ".env" and adjust.
VITE_API_BASE_URL=http://localhost:8081/api

# Optional: Google Cloud OAuth 2.0 Web Client ID (xxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Developer-only shortcuts (fake admin session, fake Google sign-in, master OTP hint).
# Put this in ".env.local" (git-ignored), never in a shared/production build:
# VITE_ENABLE_DEMO_LOGIN=true
